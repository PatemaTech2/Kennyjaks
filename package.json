{
  "name": "kennyjaks-whatsapp-rpg",
  "version": "1.0.0",
  "description": "Jujutsu Kaisen inspired WhatsApp RPG bot",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "clear-session": "node -e \"const fs=require('fs'),p='data/sessions';fs.rmSync(p,{recursive:true,force:true});fs.mkdirSync(p,{recursive:true});console.log('Session cleared')\"",
    "clear-groups": "node -e \"const fs=require('fs'),p='database/groups';fs.rmSync(p,{recursive:true,force:true});fs.mkdirSync(p,{recursive:true});console.log('Groups cleared')\""
  },
  "keywords": [
    "whatsapp",
    "bot",
    "jujutsu",
    "rpg",
    "baileys"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.8",
    "canvas": "^3.2.3",
    "chalk": "^4.1.2",
    "dotenv": "^18.0.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.2.0",
    "mongodb": "^7.6.0",
    "pino": "^9.3.2",
    "play-dl": "^1.9.7",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.3",
    "telegraf": "^4.16.3",
    "uuid": "^9.0.1",
    "yt-search": "^2.13.1",
    "ytmusic-api": "^5.3.1"
  }
}
